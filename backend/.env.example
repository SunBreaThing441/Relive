# ==========================================
# Backend Environment Configuration Example
# Copy this file to .env and fill in your values
# ==========================================

# Server Port
PORT=8000

# CORS Allowed Origin (Default frontend URL)
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection URI
# Note: The database name "OrganDonationSystem" is appended automatically by the backend (src/db/db.js).
# Do not include a trailing slash or database name at the end.
# Example for local MongoDB: mongodb://localhost:27017
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# JWT Authentication
ACCESS_TOKEN_SECRET=your_access_token_secret_key
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Credentials (Used for donor/organ image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
